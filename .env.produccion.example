# ===========================================================================
# RiwiStock en producción. Copiar a `.env` EN LA VPS y rellenar.
# ===========================================================================
#
# Lista aparte de `.env.example` a propósito: aquel lleva cinco variables que
# solo tienen sentido en el portátil (POSTGRES_PORT, DATABASE_URL,
# DATABASE_URL_TEST y los ADMIN_*), y arrastrarlas aquí invita a rellenarlas.
#
# Ninguna trae valor. Un `.env.example` con contraseñas de ejemplo acaba en
# producción tal cual: el compose falla si falta cualquiera de las obligatorias,
# que es mejor que arrancar con algo adivinable.

# ---------------------------------------------------------------------------
# ENCRYPTION_KEY — EL PASO 1, Y EL ÚNICO QUE NO SE PUEDE DESHACER
# ---------------------------------------------------------------------------
#
# ES LA MISMA QUE CIFRÓ LOS DATOS QUE SE VAN A CARGAR. La carga inicial va por
# volcado desde el portátil (`docs/despliegue.md`), y los campos cifrados viajan
# cifrados: con otra clave, las contraseñas BIOS y las keys de licencia quedan
# ilegibles para siempre, y ningún respaldo lo arregla.
#
# El orden correcto, en la red interna: se genera UNA clave nueva, se guarda en
# el gestor de contraseñas de la empresa (compartida solo entre los admin), se
# pone en el `.env` del portátil ANTES de importar los Excel reales, y se copia
# aquí. No viaja por chat ni por correo. El servidor se niega a arrancar si no
# es la correcta, así que el error se ve enseguida.
#
# Ver `docs/despliegue.md`, «Paso 1» y «Red interna».
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Estas sí se generan nuevas para producción
# ---------------------------------------------------------------------------
# Firma las cookies de sesión. Mínimo 32 caracteres. Obligatoria en producción:
# un secreto generado al vuelo invalida todas las sesiones en cada despliegue.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Credenciales del contenedor de Postgres. Solo las usa la aplicación por la red
# interna de compose: el servicio NO publica puerto.
POSTGRES_USER="inventario"
POSTGRES_PASSWORD=""
POSTGRES_DB="inventario_bbl"

# ---------------------------------------------------------------------------
# Red interna: cómo se entra y quién puede entrar
# ---------------------------------------------------------------------------
# La VM tiene IP privada y no es alcanzable desde internet. Caddy firma su
# propio certificado (`tls internal`), que se instala una vez en cada PC.
#
# SITIO: la IP privada de la VM, o un nombre interno si TI crea uno en el DNS.
#   p. ej.  SITIO="10.0.10.5"
SITIO=""
#
# REDES_PERMITIDAS: los rangos de las redes que pueden entrar, separados por un
# espacio: la VLAN de usuarios de Medellín y la de Barranquilla (por la VPN).
# Todo lo demás recibe 403. Si alguien de Barranquilla no puede entrar, su IP
# real aparece en /data/acceso.log del contenedor de Caddy.
#   p. ej.  REDES_PERMITIDAS="10.0.12.0/24 10.20.0.0/24"
REDES_PERMITIDAS=""

# ---------------------------------------------------------------------------
# Encabezado de las actas (etapa 5b)
# ---------------------------------------------------------------------------
# Van impresas en cada acta de entrega y devolución. Sin valor por defecto a
# propósito: el prototipo imprimía la razón social de otra empresa. Vacías, el
# acta imprime el hueco en blanco — un documento con un espacio vacío no se
# firma por error; uno con el nombre equivocado sí.
ORGANIZACION_RAZON_SOCIAL=""
ORGANIZACION_NIT=""

# ---------------------------------------------------------------------------
# Lo que NO va aquí
# ---------------------------------------------------------------------------
#
# DATABASE_URL       la arma `docker-compose.produccion.yml` con el nombre de
#                    servicio interno (`postgres:5432`), no con localhost.
# POSTGRES_PORT      la base no publica puerto en producción.
# DATABASE_URL_TEST  los tests no corren en la VPS.
# ADMIN_EMAIL/…      la cuenta se crea a mano, para que la contraseña no quede
#                    escrita en ningún fichero:
#                      docker compose -f docker-compose.produccion.yml exec -it app \
#                        node dist/herramientas/crear-usuario.cjs \
#                        correo@bbl.local "Nombre Apellido" admin
